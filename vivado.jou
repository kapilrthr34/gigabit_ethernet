start_gui
xhub::refresh_catalog [xhub::get_xstores xilinx_board_store]
xhub::refresh_catalog [xhub::get_xstores Vivado_example_project]
open_hw_manager
connect_hw_server -allow_non_jtag
open_hw_target
current_hw_device [get_hw_devices xc7a100t_0]
refresh_hw_device -update_hw_probes false [lindex [get_hw_devices xc7a100t_0] 0]
set_property PROBES.FILE {/home/aujus_dsp_1/Documents/Learning/gigabit_ethernet/Output/bitstream/gmii_top.ltx} [get_hw_devices xc7a100t_0]
set_property FULL_PROBES.FILE {/home/aujus_dsp_1/Documents/Learning/gigabit_ethernet/Output/bitstream/gmii_top.ltx} [get_hw_devices xc7a100t_0]
set_property PROGRAM.FILE {/home/aujus_dsp_1/Documents/Learning/gigabit_ethernet/Output/bitstream/gmii_top.bit} [get_hw_devices xc7a100t_0]
program_hw_devices [get_hw_devices xc7a100t_0]
refresh_hw_device [lindex [get_hw_devices xc7a100t_0] 0]
display_hw_ila_data [ get_hw_ila_data hw_ila_data_1 -of_objects [get_hw_ilas -of_objects [get_hw_devices xc7a100t_0] -filter {CELL_NAME=~"u_ila_rx"}]]
display_hw_ila_data [ get_hw_ila_data hw_ila_data_2 -of_objects [get_hw_ilas -of_objects [get_hw_devices xc7a100t_0] -filter {CELL_NAME=~"u_ila_tx"}]]
display_hw_ila_data [ get_hw_ila_data hw_ila_data_3 -of_objects [get_hw_ilas -of_objects [get_hw_devices xc7a100t_0] -filter {CELL_NAME=~"u_ila_mdio"}]]
